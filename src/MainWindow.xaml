<Window x:Class="KymaSoho.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="KYMA RADIO AUTOMATION | Studio" Width="1600" Height="920" MinWidth="1180" MinHeight="720" Background="#171717" Foreground="#EAF1FA" WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown" FontFamily="Segoe UI">
<Window.Resources>
 <SolidColorBrush x:Key="Panel" Color="#242424"/>
 <SolidColorBrush x:Key="Panel2" Color="#303030"/>
 <Style TargetType="Button"><Setter Property="Foreground" Value="#F4F7FC"/><Setter Property="Background" Value="#353535"/><Setter Property="BorderBrush" Value="#505050"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#E6E6E6"/><Setter TargetName="B" Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ListBox"><Setter Property="Background" Value="#191919"/><Setter Property="Foreground" Value="#E8F1FA"/><Setter Property="BorderBrush" Value="#444444"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="13"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,7"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#263B52"/><Setter Property="Foreground" Value="#E8F1FA"/><Setter Property="Background" Value="#242424"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#45325D"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#393939"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style></Setter.Value></Setter></Style>
 <Style TargetType="TextBox"><Setter Property="Background" Value="#141414"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#595959"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,7"/><Setter Property="CaretBrush" Value="White"/></Style>
 <Style x:Key="SectionHeader" TargetType="Border"><Setter Property="Background" Value="#303030"/><Setter Property="BorderBrush" Value="#484848"/><Setter Property="BorderThickness" Value="0,0,0,2"/><Setter Property="Padding" Value="12,8"/></Style>
</Window.Resources>
<Grid Margin="3"><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="174"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>
<Border Background="#252525" CornerRadius="0" BorderBrush="#484848" BorderThickness="1" Padding="10,3"><DockPanel LastChildFill="True"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"><Button Content="ΜΙΑ ΒΙΒΛΙΟΘΗΚΗ" Click="SingleLayout_Click"/><Button Content="ΔΙΠΛΗ ΒΙΒΛΙΟΘΗΚΗ" Click="DoubleLayout_Click"/><Button x:Name="AutoButton" Content="MANUAL" Background="#8A4A33" Click="Auto_Click"/><Button x:Name="RepeatButton" Content="REPEAT OFF" Background="#464A5A" Click="Repeat_Click"/><TextBlock Text="FADE" Foreground="#91B2D3" VerticalAlignment="Center" Margin="8,0,2,0"/><Slider x:Name="CrossfadeSlider" Minimum="0" Maximum="15" Value="5" Width="95" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Crossfade_Changed"/><TextBlock x:Name="CrossfadeValue" Text="5 s" Width="30" VerticalAlignment="Center" Foreground="#EAF1FA"/></StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#393939" CornerRadius="0" Padding="8,4" Margin="0,0,10,0"><TextBlock Text="KYMA" FontSize="20" FontWeight="Black" Foreground="White"/></Border><StackPanel><TextBlock Text="RADIO AUTOMATION" FontSize="12" FontWeight="Bold"/><TextBlock Text="STUDIO  ·  BROADCAST CONSOLE" FontSize="10" Foreground="#91B2D3"/></StackPanel></StackPanel></DockPanel></Border>
<Grid Grid.Row="1" Margin="0,3,0,3" Background="#1B1B1B">
 <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="4*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
 <!-- Two compact waveform decks, aligned like the reference SOHO Studio. -->
 <Border Grid.Column="0" Background="#202020" BorderBrush="#454545" BorderThickness="1" Margin="0,0,2,0">
  <Grid><Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="7"/></Grid.RowDefinitions>
   <Grid Background="#121212"><Grid.ColumnDefinitions><ColumnDefinition Width="49"/><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions>
    <Border Background="#9A1818"><TextBlock Text="A" Foreground="White" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <TextBlock Grid.Column="1" Text="NOW ON AIR" Foreground="#F0F0F0" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="9,0"/>
    <TextBlock x:Name="NowTime" Grid.Column="2" Text="00:00" Foreground="#42F02C" FontFamily="Consolas" FontSize="25" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
   </Grid>
   <Grid Grid.Row="1" Margin="8,3"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="18"/></Grid.RowDefinitions>
    <TextBlock x:Name="NowTitle" Text="Δεν αναπαράγεται τραγούδι" FontSize="19" FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="#FFFFFF"/>
    <DockPanel Grid.Row="1"><TextBlock x:Name="NowSub" Text="Προσθέστε μουσική στη βιβλιοθήκη" Foreground="#9B9B9B" FontSize="11" TextTrimming="CharacterEllipsis"/>
     <TextBlock x:Name="FadeCountdown" Text="ΑΝΑΜΟΝΗ" DockPanel.Dock="Right" Foreground="#55F034" FontSize="11" FontWeight="Bold" Margin="10,0,0,0"/></DockPanel>
   </Grid>
   <Border Grid.Row="2" Background="#101010" BorderBrush="#404040" BorderThickness="0,1,0,0" ClipToBounds="True">
    <Grid><Canvas x:Name="NowWaveform" SizeChanged="Waveform_SizeChanged"/><Canvas IsHitTestVisible="False"><Line x:Name="WavePlayhead" X1="0" X2="0" Y1="0" Y2="70" Stroke="#F1F1F1" StrokeThickness="2"/></Canvas></Grid>
   </Border>
   <ProgressBar x:Name="PlaybackProgress" Grid.Row="3" PreviewMouseLeftButtonDown="PlaybackProgress_MouseDown" ToolTip="Κλικ για μετακίνηση μέσα στο τραγούδι" Height="7" Minimum="0" Maximum="100" Value="0" Foreground="#18B620" Background="#111111" BorderThickness="0"/>
  </Grid>
 </Border>
 <Border Grid.Column="1" Background="#202020" BorderBrush="#454545" BorderThickness="1" Margin="0,0,2,0">
  <Grid><Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Background="#121212"><Grid.ColumnDefinitions><ColumnDefinition Width="49"/><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions>
    <Border Background="#731B1B"><TextBlock Text="B" Foreground="White" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <TextBlock Grid.Column="1" Text="NEXT DECK" Foreground="#EEEEEE" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="9,0"/>
    <TextBlock Text="NEXT" Grid.Column="2" Foreground="#42F02C" FontFamily="Consolas" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
   </Grid>
   <Grid Grid.Row="1" Margin="8,3"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="18"/></Grid.RowDefinitions>
    <TextBlock x:Name="NextTitle" Text="—" FontSize="19" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
    <TextBlock Grid.Row="1" Text="Επόμενο στη λίστα εκπομπής" Foreground="#9B9B9B" FontSize="11"/>
   </Grid>
   <Border Grid.Row="2" Background="#101010" BorderBrush="#404040" BorderThickness="0,1,0,0" ClipToBounds="True"><Canvas x:Name="NextWaveform" SizeChanged="Waveform_SizeChanged"/></Border>
  </Grid>
 </Border>
 <Border Grid.Column="2" Background="#262626" BorderBrush="#454545" BorderThickness="1">
  <Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
   <TextBlock x:Name="Clock" Text="00:00:00" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" FontSize="27" FontWeight="Bold" Foreground="#FFFFFF"/>
   <UniformGrid Grid.Row="1" Columns="2" Rows="2">
    <Button Content="▶ PLAY" FontSize="11" Padding="2" Background="#333333" Click="Play_Click"/>
    <Button Content="Ⅱ PAUSE" FontSize="11" Padding="2" Background="#333333" Click="Pause_Click"/>
    <Button Content="■ STOP" FontSize="11" Padding="2" Background="#333333" Click="Stop_Click"/>
    <Button Content="⏭ NEXT" FontSize="11" Padding="2" Background="#333333" Click="Next_Click"/>
   </UniformGrid>
   <Grid Grid.Row="2" Margin="6,0"><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock Text="VOL" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#BBBBBB"/>
    <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="85" TickFrequency="5" VerticalAlignment="Center" ValueChanged="Volume_Changed" ToolTip="Ένταση αναπαραγωγής και cartwall"/>
   </Grid>
  </Grid>
 </Border>
</Grid>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="28*"/><ColumnDefinition Width="47*"/><ColumnDefinition Width="25*"/></Grid.ColumnDefinitions>
<Grid Grid.Column="0" Margin="0,0,6,0"><Grid.RowDefinitions><RowDefinition Height="39"/><RowDefinition Height="*"/><RowDefinition Height="55"/></Grid.RowDefinitions><Border Style="{StaticResource SectionHeader}" CornerRadius="5,5,0,0"><DockPanel><TextBlock Text="PLAYLIST  /  NEXT DECKS" FontWeight="Bold" FontSize="15"/><CheckBox x:Name="PreventDuplicatesCheck" Content="NO DUPLICATES" IsChecked="True" Checked="Duplicates_Changed" Unchecked="Duplicates_Changed" Foreground="#8EDCC2" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="6,0"/></DockPanel></Border><ListBox x:Name="QueueList" Grid.Row="1" DisplayMemberPath="Display" SelectionChanged="QueueList_SelectionChanged"/><Border Grid.Row="2" Background="#263448" CornerRadius="0,0,5,5"><UniformGrid Columns="6"><Button Content="▲ UP" Click="MoveUp_Click"/><Button Content="▼ DOWN" Click="MoveDown_Click"/><Button Content="REMOVE" Background="#793E4C" Click="Remove_Click"/><Button Content="▶ SELECT" Background="#236A5C" Click="PlaySelected_Click"/><Button Content="SHUFFLE" Background="#50477E" Click="ShuffleUpcoming_Click"/><Button Content="CLEAR" Background="#793E4C" Click="ClearQueue_Click"/></UniformGrid></Border></Grid>
<Grid Grid.Column="1" Margin="0,0,6,0"><Grid.RowDefinitions><RowDefinition Height="39"/><RowDefinition Height="41"/><RowDefinition Height="*"/><RowDefinition Height="53"/></Grid.RowDefinitions><Border Style="{StaticResource SectionHeader}" CornerRadius="5,5,0,0"><TextBlock Text="LIBRARIES  /  ΤΡΑΓΟΥΔΙΑ" FontWeight="Bold" FontSize="15"/></Border><Grid Grid.Row="1" Background="#263448" Margin="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" Margin="4" TextChanged="SearchBox_TextChanged" ToolTip="Αναζήτηση τίτλου ή καλλιτέχνη"/><TextBlock Grid.Column="1" Text="⌕  SEARCH" Foreground="#91B2D3" Margin="6,0,10,0" VerticalAlignment="Center" FontWeight="Bold"/></Grid><Grid Grid.Row="2"><ListBox x:Name="LibraryList" DisplayMemberPath="Display" MouseDoubleClick="LibraryList_DoubleClick"/><Grid x:Name="DualLibraryPanel" Visibility="Collapsed" Background="#142030"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Margin="2"><Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#284360" Padding="6"><TextBlock Text="LIBRARY A  /  MUSIC" Foreground="#D2E9FF" FontWeight="Bold"/></Border><ListBox x:Name="LibraryListA" Grid.Row="1" DisplayMemberPath="Display" MouseDoubleClick="LibraryA_DoubleClick"/></Grid><Grid Grid.Column="1" Margin="2"><Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#3A354E" Padding="6"><TextBlock Text="LIBRARY B  /  JINGLES" Foreground="#E9D8FF" FontWeight="Bold"/></Border><ListBox x:Name="LibraryListB" Grid.Row="1" DisplayMemberPath="Display" MouseDoubleClick="LibraryB_DoubleClick"/></Grid></Grid></Grid><Border Grid.Row="3" Background="#263448" CornerRadius="0,0,5,5"><UniformGrid Columns="6"><Button Content="+ FILES" Background="#236A5C" Click="Import_Click"/><Button Content="+ FOLDER" Background="#236A5C" Click="ImportFolder_Click"/><Button Content="+ QUEUE" Background="#285E91" Click="AddToQueue_Click"/><Button Content="M3U IN" Click="ImportPlaylist_Click"/><Button Content="M3U OUT" Click="ExportPlaylist_Click"/><Button Content="CLEAN" ToolTip="Διαγραφή αρχείων που λείπουν από τη βιβλιοθήκη" Click="RemoveMissing_Click"/></UniformGrid></Border></Grid>
<Grid x:Name="RightArea" Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="58*"/><RowDefinition Height="42*"/></Grid.RowDefinitions><Grid Grid.Row="0"><Grid.RowDefinitions><RowDefinition Height="39"/><RowDefinition Height="*"/><RowDefinition Height="50"/></Grid.RowDefinitions><Border Style="{StaticResource SectionHeader}" CornerRadius="5,5,0,0"><TextBlock Text="INSTANT JINGLES" FontWeight="Bold" FontSize="14"/></Border><UniformGrid x:Name="CartGrid" Grid.Row="1" Columns="3" Rows="3" Background="#181818"/><Border Grid.Row="2" Background="#263448"><UniformGrid Columns="3"><Button Content="+ LOAD CART" ToolTip="Φόρτωση στο πρώτο ελεύθερο pad. Δεξί κλικ σε pad για συγκεκριμένη θέση" Click="LoadCart_Click"/><Button Content="■ STOP ALL" Background="#8E4150" Click="StopCart_Click"/><Button Content="CLEAR CARTS" Click="ClearCart_Click"/></UniformGrid></Border></Grid><Grid Grid.Row="1" Margin="0,6,0,0"><Grid.RowDefinitions><RowDefinition Height="39"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions><Border Style="{StaticResource SectionHeader}" CornerRadius="5,5,0,0"><TextBlock Text="MAIN  /  HISTORY" FontWeight="Bold" FontSize="14"/></Border><ListBox x:Name="HistoryList" Grid.Row="1"/><UniformGrid Grid.Row="2" Columns="2"><Button Content="EXPORT CSV" Click="ExportHistory_Click"/><Button Content="CLEAR HISTORY" Click="ClearHistory_Click"/></UniformGrid></Grid></Grid>
</Grid>
<Border Grid.Row="3" Background="#252525" BorderBrush="#484848" BorderThickness="1" CornerRadius="6" Margin="0,6,0,0" Padding="10,2"><DockPanel><TextBlock x:Name="QueueCount" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#9BC6E8" FontWeight="Bold"/><TextBlock x:Name="StatusText" Text="KYMA RADIO AUTOMATION  |  STUDIO" VerticalAlignment="Center" Foreground="#8CE4C0" FontWeight="SemiBold"/></DockPanel></Border>
</Grid></Window>
