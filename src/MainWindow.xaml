<Window x:Class="KymaSoho.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="KYMA RADIO AUTOMATION | SOHO Classic 1.3" Width="1600" Height="920" MinWidth="1180" MinHeight="720" Background="#10151E" Foreground="#EAF1FA" WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown" FontFamily="Segoe UI">
<Window.Resources>
 <SolidColorBrush x:Key="Panel" Color="#1B2533"/>
 <SolidColorBrush x:Key="Panel2" Color="#263448"/>
 <Style TargetType="Button"><Setter Property="Foreground" Value="#F4F7FC"/><Setter Property="Background" Value="#344761"/><Setter Property="BorderBrush" Value="#536B89"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#67B9FF"/><Setter TargetName="B" Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ListBox"><Setter Property="Background" Value="#152030"/><Setter Property="Foreground" Value="#E8F1FA"/><Setter Property="BorderBrush" Value="#3B526B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="13"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,7"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#263B52"/><Setter Property="Foreground" Value="#E8F1FA"/><Setter Property="Background" Value="#19283B"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1C6593"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#294763"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style></Setter.Value></Setter></Style>
 <Style TargetType="TextBox"><Setter Property="Background" Value="#111C2A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#52708B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,7"/><Setter Property="CaretBrush" Value="White"/></Style>
 <Style x:Key="SectionHeader" TargetType="Border"><Setter Property="Background" Value="#2B3D55"/><Setter Property="BorderBrush" Value="#405D79"/><Setter Property="BorderThickness" Value="0,0,0,2"/><Setter Property="Padding" Value="12,8"/></Style>
</Window.Resources>
<Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="185"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
<Border Background="#202D40" CornerRadius="7" BorderBrush="#435D7B" BorderThickness="1" Padding="10,3"><DockPanel LastChildFill="True"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"><Button Content="ΜΙΑ ΒΙΒΛΙΟΘΗΚΗ" Click="SingleLayout_Click"/><Button Content="ΔΙΠΛΗ ΒΙΒΛΙΟΘΗΚΗ" Click="DoubleLayout_Click"/><Button x:Name="AutoButton" Content="MANUAL" Background="#8A4A33" Click="Auto_Click"/></StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#0EA5E9" CornerRadius="5" Padding="8,4" Margin="0,0,10,0"><TextBlock Text="KYMA" FontSize="20" FontWeight="Black" Foreground="White"/></Border><StackPanel><TextBlock Text="RADIO AUTOMATION" FontSize="16" FontWeight="Bold"/><TextBlock Text="SOHO CLASSIC  ·  BROADCAST CONSOLE v1.3" FontSize="10" Foreground="#91B2D3"/></StackPanel></StackPanel></DockPanel></Border>
<Grid Grid.Row="1" Margin="0,7,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="4*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="#202E40" BorderBrush="#45617E" BorderThickness="1" CornerRadius="7" Margin="0,0,6,0" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/><RowDefinition Height="36"/><RowDefinition Height="12"/></Grid.RowDefinitions><DockPanel><TextBlock Text="● ON AIR  /  NOW PLAYING" Foreground="#52E2A0" FontWeight="Bold" FontSize="13"/><TextBlock x:Name="NowTime" Text="00:00" Foreground="#F8D77B" FontSize="15" FontWeight="Bold" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel><StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock x:Name="NowTitle" Text="Δεν αναπαράγεται τραγούδι" FontSize="25" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="NowSub" Text="Προσθέστε μουσική στη βιβλιοθήκη" Foreground="#A8BFD5" TextTrimming="CharacterEllipsis" FontSize="12"/></StackPanel><Border Grid.Row="2" Background="#0B1420" CornerRadius="4" BorderBrush="#344E67" BorderThickness="1" ClipToBounds="True"><Grid><Canvas x:Name="NowWaveform" Height="37" SizeChanged="Waveform_SizeChanged"/><TextBlock Text="NOW AUDIO / WAV PCM" Foreground="#8094A9" FontSize="9" Margin="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/></Grid></Border><ProgressBar x:Name="PlaybackProgress" Grid.Row="3" Height="7" Minimum="0" Maximum="100" Value="0" Foreground="#19B9A0" Background="#0C1826" BorderThickness="0"/></Grid></Border>
<Border Grid.Column="1" Background="#202E40" BorderBrush="#45617E" BorderThickness="1" CornerRadius="7" Margin="0,0,6,0" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions><TextBlock Text="◷  NEXT ON AIR" Foreground="#F6C967" FontWeight="Bold" FontSize="13"/><StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock x:Name="NextTitle" Text="—" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Text="Επόμενο στη λίστα εκπομπής" Foreground="#A8BFD5" FontSize="12"/></StackPanel><Border Grid.Row="2" Background="#0B1420" CornerRadius="4" ClipToBounds="True"><Canvas x:Name="NextWaveform" Height="32" SizeChanged="Waveform_SizeChanged"/></Border></Grid></Border>
<Border Grid.Column="2" Background="#202E40" BorderBrush="#45617E" BorderThickness="1" CornerRadius="7" Padding="5"><Grid><Grid.RowDefinitions><RowDefinition Height="37"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions><TextBlock x:Name="Clock" Text="00:00:00" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" FontSize="25" FontWeight="Bold" Foreground="#7FE1FF"/><UniformGrid Grid.Row="1" Columns="2" Rows="2"><Button Content="▶ PLAY" FontSize="11" Padding="2" Background="#19784F" Click="Play_Click"/><Button Content="Ⅱ PAUSE" FontSize="11" Padding="2" Background="#A27624" Click="Pause_Click"/><Button Content="■ STOP" FontSize="11" Padding="2" Background="#A13C48" Click="Stop_Click"/><Button Content="⏭ NEXT" FontSize="11" Padding="2" Background="#275E94" Click="Next_Click"/></UniformGrid><TextBlock Grid.Row="2" Text="STUDIO CONTROL  •  LIVE" Foreground="#A5B9D0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/></Grid></Border></Grid>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="32*"/><ColumnDefinition Width="42*"/><ColumnDefinition Width="26*"/></Grid.ColumnDefinitions>
<Grid Grid.Column="0" Margin="0,0,6,0"><Grid.RowDefinitions><RowDefinition Height="39"/><RowDefinition Height="*"/><RowDefinition Height="55"/></Grid.RowDefinitions><Border Style="{StaticResource SectionHeader}" CornerRadius="5,5,0,0"><DockPanel><TextBlock Text="PLAYLIST / ON AIR" FontWeight="Bold" FontSize="15"/><TextBlock Text="  LIVE QUEUE" Foreground="#8EDCC2" HorizontalAlignment="Right" DockPanel.Dock="Right"/></DockPanel></Border><ListBox x:Name="QueueList" Grid.Row="1" DisplayMemberPath="Display" SelectionChanged="QueueList_SelectionChanged"/><Border Grid.Row="2" Background="#263448" CornerRadius="0,0,5,5"><UniformGrid Columns="4"><Button Content="▲ UP" Click="MoveUp_Click"/><Button Content="▼ DOWN" Click="MoveDown_Click"/><Button Content="REMOVE" Background="#793E4C" Click="Remove_Click"/><Button Content="▶ SELECT" Background="#236A5C" Click="PlaySelected_Click"/></UniformGrid></Border></Grid>
<Grid Grid.Column="1" Margin="0,0,6,0"><Grid.RowDefinitions><RowDefinition Height="39"/><RowDefinition Height="41"/><RowDefinition Height="*"/><RowDefinition Height="53"/></Grid.RowDefinitions><Border Style="{StaticResource SectionHeader}" CornerRadius="5,5,0,0"><TextBlock Text="MUSIC LIBRARY / ΤΡΑΓΟΥΔΙΑ" FontWeight="Bold" FontSize="15"/></Border><Grid Grid.Row="1" Background="#263448" Margin="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" Margin="4" TextChanged="SearchBox_TextChanged" ToolTip="Αναζήτηση τίτλου ή καλλιτέχνη"/><TextBlock Grid.Column="1" Text="⌕  SEARCH" Foreground="#91B2D3" Margin="6,0,10,0" VerticalAlignment="Center" FontWeight="Bold"/></Grid><Grid Grid.Row="2"><ListBox x:Name="LibraryList" DisplayMemberPath="Display" MouseDoubleClick="LibraryList_DoubleClick"/><Grid x:Name="DualLibraryPanel" Visibility="Collapsed" Background="#142030"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Margin="2"><Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#284360" Padding="6"><TextBlock Text="LIBRARY A  /  MUSIC" Foreground="#D2E9FF" FontWeight="Bold"/></Border><ListBox x:Name="LibraryListA" Grid.Row="1" DisplayMemberPath="Display" MouseDoubleClick="LibraryA_DoubleClick"/></Grid><Grid Grid.Column="1" Margin="2"><Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#3A354E" Padding="6"><TextBlock Text="LIBRARY B  /  JINGLES" Foreground="#E9D8FF" FontWeight="Bold"/></Border><ListBox x:Name="LibraryListB" Grid.Row="1" DisplayMemberPath="Display" MouseDoubleClick="LibraryB_DoubleClick"/></Grid></Grid></Grid><Border Grid.Row="3" Background="#263448" CornerRadius="0,0,5,5"><UniformGrid Columns="3"><Button Content="+ IMPORT" Background="#236A5C" Click="Import_Click"/><Button Content="+ TO PLAYLIST" Background="#285E91" Click="AddToQueue_Click"/><Button Content="SAVE" Click="Save_Click"/></UniformGrid></Border></Grid>
<Grid x:Name="RightArea" Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="58*"/><RowDefinition Height="42*"/></Grid.RowDefinitions><Grid Grid.Row="0"><Grid.RowDefinitions><RowDefinition Height="39"/><RowDefinition Height="*"/><RowDefinition Height="50"/></Grid.RowDefinitions><Border Style="{StaticResource SectionHeader}" CornerRadius="5,5,0,0"><TextBlock Text="INSTANT JINGLES / CARTWALL" FontWeight="Bold" FontSize="14"/></Border><UniformGrid x:Name="CartGrid" Grid.Row="1" Columns="3" Rows="3" Background="#172235"/><Border Grid.Row="2" Background="#263448"><UniformGrid Columns="2"><Button Content="+ LOAD CART" ToolTip="Φόρτωση στο πρώτο ελεύθερο pad. Δεξί κλικ σε pad για συγκεκριμένη θέση" Click="LoadCart_Click"/><Button Content="■ STOP CART" Background="#8E4150" Click="StopCart_Click"/></UniformGrid></Border></Grid><Grid Grid.Row="1" Margin="0,6,0,0"><Grid.RowDefinitions><RowDefinition Height="39"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource SectionHeader}" CornerRadius="5,5,0,0"><TextBlock Text="HISTORY / RECENTLY PLAYED" FontWeight="Bold" FontSize="14"/></Border><ListBox x:Name="HistoryList" Grid.Row="1"/></Grid></Grid>
</Grid>
<Border Grid.Row="3" Background="#202D40" BorderBrush="#435D7B" BorderThickness="1" CornerRadius="6" Margin="0,6,0,0" Padding="10,2"><DockPanel><TextBlock x:Name="QueueCount" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#9BC6E8" FontWeight="Bold"/><TextBlock x:Name="StatusText" Text="READY | KYMA SOHO CLASSIC 1.3" VerticalAlignment="Center" Foreground="#8CE4C0" FontWeight="SemiBold"/></DockPanel></Border>
</Grid></Window>
